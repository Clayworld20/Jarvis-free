{
  "language": "en",
  "fillers": ["jarvis", "please", "hey"],
  "messages": {
    "unknown": "Sorry, I did not understand that.",
    "done": "Done.",
    "error": "Something went wrong while running that command. See the log for details.",
    "wake": "Yes?",
    "opened": "Opening {app}.",
    "unknown_app": "I don't know how to open {app}. Add it in the app settings.",
    "searching": "Searching for {query}.",
    "nothing_to_search": "What should I search for?",
    "locked": "The computer is locked.",
    "confirm_power": "Please confirm by saying \"confirm\".",
    "power_scheduled": "Scheduled {kind} in {delay} seconds. Say \"cancel\" to abort.",
    "power_cancelled": "Shutdown cancelled.",
    "power_unsupported": "That command is only supported on Windows.",
    "nothing_to_confirm": "There is nothing to confirm.",
    "stopped": "Stopped.",
    "note_saved": "Note saved.",
    "note_empty": "What should I write down?",
    "system_info": "System: {info}.",
    "help": "I can tell the time and date, open apps and websites, search the web, save notes, lock the computer and run scripts. Say \"Jarvis\" followed by a command.",
    "script_done": "Script finished.",
    "script_missing": "Script \"{name}\" was not found."
  },
  "intents": [
    {"id": "greet", "action": null, "patterns": ["hello", "hi", "good morning", "good evening", "good afternoon"], "responses": ["Hello.", "Hello! How can I help?"]},
    {"id": "bye", "action": null, "patterns": ["bye", "goodbye", "see you"], "responses": ["Goodbye."]},
    {"id": "thanks", "action": null, "patterns": ["thanks", "thank you"], "responses": ["You're welcome.", "Always a pleasure."]},
    {"id": "time", "action": "time", "patterns": ["what time is it", "what's the time", "tell me the time", "current time"], "responses": ["It is {time}."]},
    {"id": "date", "action": "date", "patterns": ["what is the date", "what's the date", "what day is it", "today's date"], "responses": ["Today is {date}."]},
    {"id": "open_app", "action": "open_app", "patterns": ["open {app}", "launch {app}", "start {app}"]},
    {"id": "search", "action": "search_web", "patterns": ["search for {query}", "search {query}", "google {query}", "look up {query}"]},
    {"id": "lock", "action": "lock", "patterns": ["lock the computer", "lock screen", "lock"]},
    {"id": "power_off", "action": "power_off", "patterns": ["shut down the computer", "shut down", "turn off the computer"]},
    {"id": "reboot", "action": "reboot", "patterns": ["restart the computer", "restart", "reboot"]},
    {"id": "cancel_power", "action": "cancel_power", "patterns": ["cancel shutdown", "cancel restart", "cancel"]},
    {"id": "confirm", "action": "confirm", "patterns": ["confirm", "yes", "yes please"]},
    {"id": "stop", "action": "stop", "patterns": ["stop", "be quiet", "enough"]},
    {"id": "note", "action": "note", "patterns": ["take a note {text}", "make a note {text}", "note {text}", "remember {text}"]},
    {"id": "system_info", "action": "system_info", "patterns": ["system information", "what system is this", "which operating system"]},
    {"id": "help", "action": "help", "patterns": ["what can you do", "help", "list commands"]}
  ]
}
